# Copy to .env.local for local dev. On Vercel, add these in Project Settings -> Environment Variables.
# NEVER commit real values. NEVER prefix the service-role key with NEXT_PUBLIC_.

# Public site URL (used for SEO, sitemap). Example: https://vardaan.in
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase (server-only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard
ADMIN_PASSWORD=choose-a-long-password
# Random 32+ character string, e.g. from: openssl rand -hex 32
ADMIN_SESSION_SECRET=random-hex-string

# --- Firebase (optional: use Firestore instead of Supabase for sign-ups) ---
# Paste the full service-account JSON (or base64 of it). Server-only. Never prefix with NEXT_PUBLIC_.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# On Firebase App Hosting, set FIREBASE_USE_ADC=1 instead (apphosting.yaml does this).
# FIREBASE_USE_ADC=1

# Firebase web config (public; defaults to the vardaan-tech project if unset)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
